# =============================================================================
# CLOPUS v3 Worker
# =============================================================================
# Claude Code worker container with full development capabilities

FROM clopus-base:latest

LABEL maintainer="CLOPUS Team"
LABEL version="3.0.0"
LABEL description="CLOPUS Claude Code Worker"

# =============================================================================
# Setup for non-root user (ubuntu UID 1000)
# =============================================================================
RUN mkdir -p /workspace /app/ipc /home/ubuntu/.claude && \
    chown -R ubuntu:ubuntu /workspace /app /home/ubuntu

# =============================================================================
# Worker Configuration
# =============================================================================
WORKDIR /workspace

# Copy worker configuration
COPY --chown=ubuntu:ubuntu workers/system-prompts/ /app/system-prompts/
COPY --chown=ubuntu:ubuntu workers/hooks/ /app/hooks/
COPY --chown=ubuntu:ubuntu skills/ /app/skills/

# MCP servers are built separately and mounted at runtime
# See Dockerfile.mcp-servers for build process
# Mount point: /app/mcp-servers (from mcp-servers volume or pre-built image)

# Copy MCP configuration for Claude Code
COPY --chown=ubuntu:ubuntu workers/.mcp.json /workspace/.mcp.json

# Make hooks executable
RUN chmod +x /app/hooks/*.sh 2>/dev/null || true

# =============================================================================
# Entry Point Script
# =============================================================================
COPY --chown=ubuntu:ubuntu workers/worker-entrypoint.sh /app/worker-entrypoint.sh
RUN chmod +x /app/worker-entrypoint.sh

# =============================================================================
# Environment
# =============================================================================
ENV WORKER_ID=1
ENV WORKER_ROLE=coder
ENV IPC_PATH=/app/ipc
ENV HOME=/home/ubuntu

# Switch to non-root user for Claude Code
USER ubuntu

CMD ["/app/worker-entrypoint.sh"]
