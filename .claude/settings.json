{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(**/*)",
      "Edit(**/*)",
      "Write(**/*)",
      "Glob(**/*)",
      "Grep(**/*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=/dev/zero:*)",
      "Read(.env.production)"
    ],
    "additionalDirectories": [
      "/workspace",
      "/app/ipc",
      "/app/claude-config",
      "/tmp"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ubuntu/.claude/hooks/validate_command.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ubuntu/.claude/hooks/log_operation.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "CLOPUS_IPC_PATH": "/app/ipc",
    "CLOPUS_WORKSPACE": "/workspace"
  }
}
