# =============================================================================
# CLOPUS v3 Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Authentication mode: oauth | api
# - oauth: Use Claude Max/Pro subscription (recommended)
# - api: Use Anthropic API key
AUTH_MODE=oauth

# For OAuth mode (Claude Max/Pro subscription):
# Run `claude login` first, then `claude setup-token` to get this token
CLAUDE_OAUTH_TOKEN=

# For API mode only:
# Anthropic API Key (only needed if AUTH_MODE=api)
ANTHROPIC_API_KEY=

# GitHub Token (optional, gh CLI handles auth)
GITHUB_TOKEN=

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================

# Number of parallel Claude Code workers
WORKERS=5

# Default model for workers
CLAUDE_MODEL=claude-sonnet-4-20250514

# =============================================================================
# EMAIL SERVICES
# =============================================================================

# Resend API Key
RESEND_API_KEY=

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Stripe (for payment integrations)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI (for comparison/fallback)
OPENAI_API_KEY=

# Google Calendar (for calendar MCP server)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
GOOGLE_REFRESH_TOKEN=

# Firebase (for notifications MCP server)
# FIREBASE_SERVICE_ACCOUNT should be the JSON service account key as a single line
FIREBASE_SERVICE_ACCOUNT=

# OneSignal (alternative notification provider)
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# =============================================================================
# CLOUD PROVIDERS
# =============================================================================

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# DEPLOYMENT PLATFORMS
# =============================================================================

# Vercel
VERCEL_TOKEN=

# Railway
RAILWAY_TOKEN=

# Fly.io
FLY_API_TOKEN=

# =============================================================================
# DATABASE CONNECTIONS (for deployed apps)
# =============================================================================

# Production database URLs (used by deployed apps, not CLOPUS itself)
DATABASE_URL=
REDIS_URL=

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Confidence threshold for autonomous decisions (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.7

# Validation coverage threshold (percentage)
COVERAGE_THRESHOLD=80

# GitHub settings
GITHUB_DEFAULT_VISIBILITY=private
GITHUB_AUTO_PUSH=true

# =============================================================================
# INTERNAL SERVICES (usually don't need to change)
# =============================================================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=clopus
POSTGRES_PASSWORD=clopus
POSTGRES_DB=clopus

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# ChromaDB
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# MinIO
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Browser VNC
VNC_PORT=6080
