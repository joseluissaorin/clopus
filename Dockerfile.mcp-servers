# =============================================================================
# CLOPUS v3 MCP Servers Builder
# =============================================================================
# Builds all TypeScript MCP servers for use by workers

FROM node:20-alpine AS builder

WORKDIR /build

# Copy all MCP server sources
COPY mcp-servers/ ./mcp-servers/

# Install dependencies and build each server
RUN apk add --no-cache python3 make g++ && \
    for dir in ./mcp-servers/core/*/; do \
        if [ -f "$dir/package.json" ]; then \
            echo "Building $(basename $dir)..." && \
            cd "$dir" && \
            npm install --silent && \
            npm run build 2>/dev/null || npx tsc --skipLibCheck 2>/dev/null || true && \
            cd /build; \
        fi \
    done

# =============================================================================
# Final stage - just the built servers
# =============================================================================
FROM node:20-alpine

WORKDIR /app/mcp-servers

# Copy built servers
COPY --from=builder /build/mcp-servers/core ./core
COPY --from=builder /build/mcp-servers/generated ./generated

# Verify builds
RUN find . -name "dist" -type d | head -10

CMD ["echo", "MCP servers built successfully"]
